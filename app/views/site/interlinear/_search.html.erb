<div data-controller="book">
  <%= form_with url: site_interlinear_path, method: :get,
        class: "max-w-xl mx-auto mt-12 space-y-6" do %>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

      <!-- Book -->
      <div class="md:col-span-1">
        <%= select_tag :bible_book,
          grouped_options_for_select(
            @bible_books_grouped,
            params[:bible_book].presence || BibleBook.first.name
          ),
          prompt: "Select Book",
          data: { action: "change->book#change" },
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg"
        %>
      </div>

      <!-- Chapter (THIS will be replaced) -->
      <div id="chapter_select">
        <%= select_tag :chapter,
          options_for_select(@chapters, params[:chapter] || 1),
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg"
        %>
      </div>

      <!-- Verse -->
      <div>
        <%= number_field_tag :verse, params[:verse],
          placeholder: "Verse (optional)",
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg"
        %>
      </div>

    </div>

    <div class="text-center">
      <%= submit_tag "Search",
        class: "px-6 py-2 bg-indigo-600 text-white font-semibold rounded-lg"
      %>
    </div>

  <% end %>
</div>