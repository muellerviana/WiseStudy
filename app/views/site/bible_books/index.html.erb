<div class="p-20 mx-auto">
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 mt-4">
    <% @bible_books.each do |bible_book| %>
      <%= link_to site_bible_book_path(bible_book),
          class: "block border border-gray-300 rounded-lg p-2 text-center shadow-sm
                  hover:bg-blue-400 hover:text-white transition-colors duration-200
                  font-medium text-gray-800" do %>
        <%= bible_book.name %>
      <% end %>
    <% end %>
  </div>
</div>