<div class="px-32 mx-auto">
  
  <h1 class="font-bold text-3xl text-center p-4"><%= @bible_book.name %> <%=  @chapter.number %>:<%= @verses.first.number %>-<%= @verses.last.number %></h1>

  <table class="min-w-full rounded-lg shadow-sm">
    <thead class="bg-gray-100">
      <tr>
        <th class="px-4 py-2 text-left font-semibold text-gray-700">Verse</th>
        <th class="px-4 py-2 text-left font-semibold text-gray-700">Words</th>
      </tr>
    </thead>
    <tbody>
      <% @verses.each do |verse| %>
        <tr class="odd:bg-white even:bg-gray-200 transition">
          <td class="px-4 py-2 font-bold align-top w-16"><%= verse.number %></td>
          <td class="px-4 py-2">
            <% verse.words.each do |word| %>
              <div class="inline-block mx-3 text-center align-top">
                <!-- Strong's number -->
                <div class="text-xs text-gray-400">1001</div>

                <!-- Original word (Greek/Hebrew) -->
                <div class="font-semibold text-lg"><%= word.original %></div>

                <!-- Transliteration -->
                <div class="italic text-sm text-blue-700"><%= word.transliteration || "transliteration" %></div>

                <!-- Translation -->
                <div class="text-sm text-gray-600"><%= word.translation || "translation" %></div>
              </div>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>


</div>