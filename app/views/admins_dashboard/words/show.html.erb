<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
  <h1 class="text-2xl sm:text-3xl font-bold mb-6">Word Details</h1>

  <!-- Originals partial -->
  <div class="my-6 sm:my-8">
    <%= render 'admins_dashboard/words/originals', verse: @verse, book: @book, chapter: @chapter, word: @word %>
  </div>

  <!-- Word details card -->
  <div class="p-4 sm:p-6 bg-gray-50 rounded-2xl shadow-md">
    <h2 class="my-2 sm:my-4 text-2xl sm:text-3xl">
      <strong class="text-gray-700"><%= @word.original %></strong>
    </h2>

    <div class="space-y-1 mb-4">
      <p class="text-gray-500"><%= @word.transliteration %></p>
      <p class="text-gray-500"><%= @word.translation %></p>
    </div>

    <!-- Reference and position -->
    <div class="my-4 flex flex-col sm:flex-row justify-center items-center gap-2 sm:gap-4 text-lg sm:text-xl">
      <p class="text-gray-600 font-bold">
        <%= "#{@book.name} #{@chapter.number}:#{@verse.number}" %>
      </p>
      <p class="text-gray-500">
        - Position: <%= @word.position %>
      </p>
    </div>

    <!-- Internal ID -->
    <div class="mb-2 text-sm sm:text-base">
      <strong>Internal ID:</strong> <%= @word.id %>
    </div>

    <hr class="my-4 border-gray-300">

    <!-- Form section -->
    <% missing = [@word.original, @word.transliteration, @word.translation, @word.strong_number].any?(&:blank?) %>
    <div class="<%= 'bg-red-100 p-3 rounded-lg' if missing %>">
      <%= form_with(model: @word, url: admins_dashboard_bible_book_chapter_verse_word_path(@book, @chapter, @verse, @word), method: :patch, local: true, class: "space-y-4") do |f| %>
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
          <strong>Original:</strong>
          <%= f.text_field :original, class: "w-full sm:w-2/3 border rounded px-2 py-1" %>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
          <strong>Strong's Number:</strong>
          <%= f.text_field :strong_number, class: "w-full sm:w-2/3 border rounded px-2 py-1", step: 1 %>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
          <strong>Transliteration:</strong>
          <%= f.text_field :transliteration, class: "w-full sm:w-2/3 border rounded px-2 py-1" %>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
          <strong>Translation:</strong>
          <%= f.text_field :translation, class: "w-full sm:w-2/3 border rounded px-2 py-1" %>
        </div>

        <%= f.submit "Save", class: "w-full sm:w-auto mt-2 px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition" %>
      <% end %>

      <% if flash[:alert] %>
        <div class="bg-red-100 border border-red-500 text-red-700 px-4 py-3 my-4 rounded relative" role="alert">
          <strong class="font-bold">Alert:</strong>
          <span class="block sm:inline"><%= flash[:alert] %></span>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Verse partial -->
  <div class="my-8">
    <%= render 'admins_dashboard/words/verse', verse: @verse, book: @book, chapter: @chapter, word: @word %>
  </div>

  <!-- Back link -->
  <div class="flex justify-center mt-6">
    <%= link_to admins_dashboard_bible_book_chapter_path(@book, @chapter), class: "flex items-center text-blue-600 hover:text-blue-800 transition group" do %>
      <svg class="w-5 h-5 mr-2 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Chapter
    <% end %>
  </div>
</div>
